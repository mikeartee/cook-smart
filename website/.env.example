# Cook Smart Website - Environment Variables
# Copy this to .env.local for local development
# Set these in Vercel dashboard for production

# ============================================
# REQUIRED - Must be set for production
# ============================================

# Site URL (update with your Vercel URL or custom domain)
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# API URL (same as site URL for this project)
NEXT_PUBLIC_API_URL=https://your-project.vercel.app

# Resend API Key for sending emails
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_your_key_here

# ============================================
# OPTIONAL - Can be added later
# ============================================

# App Store URLs (add when apps are published)
NEXT_PUBLIC_ANDROID_STORE_URL=
NEXT_PUBLIC_IOS_STORE_URL=

# ============================================
# DATABASE - Auto-populated by Vercel
# ============================================
# These are automatically set when you create a Vercel Postgres database
# Do not set these manually

# POSTGRES_URL=
# POSTGRES_PRISMA_URL=
# POSTGRES_URL_NON_POOLING=
# POSTGRES_USER=
# POSTGRES_HOST=
# POSTGRES_PASSWORD=
# POSTGRES_DATABASE=
