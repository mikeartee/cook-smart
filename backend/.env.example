# Cook Smart Environment Configuration Example
#
# This file is the starting template for backend/.env. Copy it and fill in
# the values that apply to your setup:
#
#   cp backend/.env.example backend/.env
#
# Variables are grouped into MINIMUM VIABLE (required for the server to boot
# and serve a request without 500s) and FEATURE-GATED (only needed when you
# want to exercise that specific feature). See docs/codebase-assessment.md
# Section 4 for the full breakdown.
#
# As of issue #23, missing env files are non-fatal — backend/load-env.js
# will warn and continue. Per-feature errors surface from the routes that
# need them.

# ─── MINIMUM VIABLE: required to serve authenticated requests ──────────────

# Postgres connection. The pg Pool in src/config/database.ts reads these.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cooksmartdb
DB_USER=postgres
DB_PASSWORD=postgres

# JWT secret for token issue/verify (src/middleware/auth.ts).
# Any string of 32+ characters is fine for local; do not reuse in production.
JWT_SECRET=replace-with-32-plus-character-local-secret
JWT_EXPIRES_IN=7d

# Server runtime.
NODE_ENV=development
PORT=3000

# ─── FEATURE-GATED: only set when you want the feature to work ─────────────

# Optional alternative to DB_* variables — pg Pool uses DB_* by default.
# DATABASE_URL=postgresql://user:password@host:5432/database

# Recipe API (FatSecret Premier — sole registered provider as of slice #21).
# Without these, recipe search returns []; the server still boots.
FATSECRET_CLIENT_ID=your-fatsecret-client-id
FATSECRET_CLIENT_SECRET=your-fatsecret-client-secret

# Barcode API keys (currently listed in .env but not actually imported).
NUTRITIONIX_APP_ID=your-nutritionix-app-id
NUTRITIONIX_API_KEY=your-nutritionix-api-key
USDA_API_KEY=DEMO_KEY

# Discord webhooks (optional — without these, NotificationService no-ops).
DISCORD_WEBHOOK_URL=your-discord-webhook-url
DISCORD_ERROR_WEBHOOK_URL=your-discord-error-webhook-url
DISCORD_FEEDBACK_WEBHOOK=your-discord-feedback-webhook
DISCORD_ACTIVITY_WEBHOOK=your-discord-activity-webhook

# Stripe (optional — payment routes degrade gracefully without these).
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key
STRIPE_BETA_PRICE_ID=price_your-beta-price-id
STRIPE_YEARLY_PRICE_ID=price_your-yearly-price-id
STRIPE_MONTHLY_PRICE_ID=price_your-monthly-price-id
STRIPE_WEEKLY_PRICE_ID=price_your-weekly-price-id
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Email via Resend (contact form, password resets, subscription emails).
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM=Cook Smart <noreply@cooksmartapp.com>
ADMIN_EMAIL=services.cooksmart@gmail.com

# Support / app surface.
SUPPORT_EMAIL=services.cooksmart@gmail.com
APP_URL=https://cooksmartapp.com
