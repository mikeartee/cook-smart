# Cook Smart - Production Environment Variables Template
# Copy this file to .env.production and fill in your actual values

# Environment
NODE_ENV=production
PORT=3000

# Database
DATABASE_URL=postgresql://username:password@your-rds-endpoint.rds.amazonaws.com:5432/cook_smart

# JWT Secrets (Generate secure random strings)
JWT_SECRET=your-super-secret-jwt-key-here-min-32-chars
ADMIN_JWT_SECRET=your-super-secret-admin-jwt-key-here-min-32-chars

# API Keys
THEMEALDB_API_KEY=1
EDAMAM_APP_ID=your-edamam-app-id
EDAMAM_APP_KEY=your-edamam-app-key

# Discord Webhooks
DISCORD_WEBHOOK_ERRORS=https://discord.com/api/webhooks/your-error-webhook
DISCORD_WEBHOOK_FEEDBACK=https://discord.com/api/webhooks/your-feedback-webhook
DISCORD_WEBHOOK_ACTIVITY=https://discord.com/api/webhooks/your-activity-webhook

# Optional: Email Service (for verification emails)
# EMAIL_SERVICE=smtp
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-app-password

# Optional: AWS Configuration (if using AWS SDK)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
