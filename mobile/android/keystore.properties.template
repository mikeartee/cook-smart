# Cook Smart - Flutter Mobile App release signing configuration.
#
# Copy this file to `keystore.properties` (alongside this template, in
# `mobile/android/`) and fill in the four values below to enable signed
# release builds. The real `keystore.properties` file is gitignored at the
# repo root and MUST NOT be committed (Requirements 17.2, 17.3).
#
# All four entries are required. A release build (`flutter build apk
# --release` / `flutter build appbundle --release`) aborts with an explicit
# error if this file is missing or any of the four keys are absent
# (Requirements 17.5, 17.6).
#
# `storeFile` is resolved relative to `mobile/android/`, so the keystore
# itself can live at e.g. `mobile/android/app/cooksmart-release.keystore`
# (also gitignored via `*.keystore` / `*.jks`).

storeFile=app/cooksmart-release.keystore
storePassword=replace-with-keystore-password
keyAlias=replace-with-key-alias
keyPassword=replace-with-key-password
